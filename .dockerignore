# Limit the build context to application source and frontend build inputs.
# Use literal directory exceptions so Docker can prune private runtime data.
*
!LICENSE
!backend/
backend/__pycache__/
backend/requirements-dev.txt
!frontend/
frontend/*
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/src/
!frontend/scripts/
!frontend/public/
# Never send environment files, even if later added under an allowed directory.
**/.env
**/.env.*
# Prune runtime directories explicitly: export storage is private (0700) and
# must not be traversed by the Docker client while collecting source files.
data/
data-dev/
recordings/
recordings-dev/
