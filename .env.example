# Copy to .env. Defaults use a published Docker Hub image; no cameras are preconfigured.
# Linux LAN: use compose.lan.yml for native WebRTC address discovery.
# Bridge networking: set WEBRTC_HOST when viewing from another device.
NVR_PORT=8080
# For LAN access set 0.0.0.0 and configure authentication.
NVR_BIND=127.0.0.1
# WEBRTC_PORT is obsolete: signaling uses the application port.
WEBRTC_UDP_PORT=8189
# Leave blank with compose.lan.yml; MediaMTX advertises host interface addresses.
# With the default bridge deployment, set the host LAN IP (blank = localhost).
# NAT/VPN: comma-separated reachable IPs or DNS names are also supported.
WEBRTC_HOST=
DATA_DIR=./data
# Host path, not a container path. Mount external storage before starting recording.
DEFAULT_RECORDING_PATH=./recordings
MIN_FREE_SPACE_GB=5
SEGMENT_SECONDS=600
LOG_LEVEL=INFO
# Initial UI language: en or ru. Browser language selections override this.
DEFAULT_LANGUAGE=en
# Initial installation timezone. A timezone saved in the UI takes precedence.
APP_TIMEZONE=UTC
AUTH_USERNAME=
AUTH_PASSWORD=
# Set BOTH auth values for a shared installation. Authentication is disabled if blank.
# Login protects browser signaling. Never publish MediaMTX TCP ports.
# Set true when the UI is served over HTTPS.
COOKIE_SECURE=false
# For an HTTPS reverse proxy, set its actual IP(s) so Uvicorn trusts its scheme headers.
# Do not use * for an application reachable directly by untrusted clients.
FORWARDED_ALLOW_IPS=127.0.0.1
# Optional generic HTTP(S) webhook; no notifications when blank.
WEBHOOK_URL=
WEBHOOK_TOKEN=
WEBHOOK_DEBOUNCE_SECONDS=60
WEBHOOK_COOLDOWN_SECONDS=600
# Published, explicitly versioned Docker Hub image. Keep the version pinned.
# Start with: docker compose pull && docker compose up -d --no-build
# Contributor builds use compose.dev.yml; see docs/development.md.
# Never use Docker Hub credentials here.
NVR_IMAGE=vvbelousov/tuponvr:0.2.1
# Optional numeric runtime identity. Defaults preserve existing bind-mount behavior.
# For non-root use, pre-create data/recordings with ownership matching these IDs.
NVR_UID=0
NVR_GID=0

# Optional compose.bootstrap.yml only: existing read-only camera YAML file.
# CAMERA_BOOTSTRAP_FILE=./cameras.yaml
